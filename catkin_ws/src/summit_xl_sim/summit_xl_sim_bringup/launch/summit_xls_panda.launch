<?xml version="1.0"?>
<launch>

	<!-- SUMMIT XL STEEL-->
	<!-- disables gazebo ros_control plugin -->
	<arg name="omni_drive" default="false" />
	<arg if="$(arg omni_drive)" name="ros_planar_move_plugin" value="false" />
	<arg unless="$(arg omni_drive)" name="ros_planar_move_plugin" default="true" />

	<arg name="launch_rviz" default="false" />
	<arg name="gazebo_world" default="$(find summit_xl_gazebo)/worlds/summit_xl_office.world" />
	<arg name="gazebo_gui" default="true" />
	<arg name="use_gpu_for_simulation" default="$(optenv USE_GPU_FOR_SIMULATION false)" />

	<!-- common arguments -->
	<arg name="default_xacro_package" default="$(optenv ROBOT_XACRO_PACKAGE summit_xl_description)" />

	<arg name="launch_robot" default="true" />
	<arg name="map_file" default="willow_garage/willow_garage.yaml" />
	<arg name="move_base_robot" default="false" />
	<arg name="amcl_and_mapserver" default="false" />
	<arg name="xacro_robot" default="$(optenv ROBOT_XACRO moman.urdf.xacro)" />

	<arg name="arm_id" default="panda" doc="Name of the robot to spawn" />
	<arg name="x_init_pose_robot" default="0" />
	<arg name="y_init_pose_robot" default="0" />
	<arg name="z_init_pose_robot" default="0" />

	<rosparam file="$(find franka_control)/config/moman_controllers.yaml" subst_value="true" />


	<include file="$(find summit_xl_gazebo)/launch/summit_xl_gazebo.launch">
		<!-- general args -->
		<arg name="launch_rviz" value="$(arg launch_rviz)" />
		<arg name="gazebo_world" value="$(arg gazebo_world)" />
		<arg name="gazebo_gui" value="$(arg gazebo_gui)" />
		<arg name="omni_drive" value="$(arg omni_drive)" />
		<arg name="ros_planar_move_plugin" value="$(arg ros_planar_move_plugin)" />
		<arg name="use_gpu_for_simulation" value="$(arg use_gpu_for_simulation)" />
		<arg name="default_xacro_package" value="$(arg default_xacro_package)" />
		<!-- robot_a args -->
		<arg name="launch_robot" value="$(arg launch_robot)" />
		<arg name="map_file" value="$(arg map_file)" />
		<arg name="move_base_robot" value="$(arg move_base_robot)" />
		<arg name="amcl_and_mapserver" value="$(arg amcl_and_mapserver)" />
		<arg name="xacro_robot" value="$(arg xacro_robot)" />

		<!-- base position -->
		<arg name="x_init_pose_robot" value="$(arg x_init_pose_robot)" />
		<arg name="y_init_pose_robot" value="$(arg y_init_pose_robot)" />
		<arg name="z_init_pose_robot" value="$(arg z_init_pose_robot)" />


		

	</include>


</launch>