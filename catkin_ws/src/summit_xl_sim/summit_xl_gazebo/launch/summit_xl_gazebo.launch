<?xml version="1.0"?>
<launch>

	<!--launch_navigation
	and launch_navigation_nomap args are exclusive
    and they are (or not) launched for all robots-->
	<arg name="launch_rviz" default="true" />
	<arg name="launch_robot" default="true" />
	<arg name="default_xacro_package" default="summit_xl_description" />
	<arg name="default_xacro" default="summit_xl_std.urdf.xacro" />
	<arg name="gazebo_world" default="$(find summit_xl_gazebo)/worlds/summit_xl_office.world" />
	<arg name="gazebo_gui" default="true" />
	<arg name="map_file" default="willow_garage/willow_garage.yaml" />
	<arg name="debug" default="false" />
	<arg name="omni_drive" default="false" />
	<arg name="ros_planar_move_plugin" default="false" />
	<arg name="use_gpu_for_simulation" default="false" />

	<!--params
	of the different robots-->
	<!-- GPS default position of Robotnik at Fuente del Jarro-->
	<!-- robot a -->
	<arg name="id_robot" default="robot" />
	<arg name="x_init_pose_robot" default="0" />
	<arg name="y_init_pose_robot" default="0" />
	<arg name="z_init_pose_robot" default="0" />
	<arg name="ekf_localization_robot" default="false" />
	<arg name="ekf_localization_mode" default="odom" />
	<arg name="move_base_robot" default="false" />
	<arg name="amcl_and_mapserver" default="false" />
	<arg name="xacro_robot_package" default="$(arg default_xacro_package)" />
	<arg name="xacro_robot" default="$(arg default_xacro)" />
	<arg name="gps_latitude_robot" default="39.5080331" />
	<arg name="gps_longitude_robot" default="-0.4619816" />


	<!--BEGIN
	ROBOT 1-->
	<include if="$(arg launch_robot)"
		file="$(find summit_xl_gazebo)/launch/summit_xl_one_robot.launch">
		<arg name="id_robot" value="$(arg id_robot)" />
		<arg name="x_init_pose" value="$(arg x_init_pose_robot)" />
		<arg name="y_init_pose" value="$(arg y_init_pose_robot)" />
		<arg name="z_init_pose" value="$(arg z_init_pose_robot)" />
		<arg name="xacro_robot_package" value="$(arg xacro_robot_package)" />
		<arg name="xacro_robot" value="$(arg xacro_robot)" />
		<arg name="launch_robot_ekf_localization" value="$(arg ekf_localization_robot)" />
		<arg name="robot_ekf_localization_mode" value="$(arg ekf_localization_mode)" />
		<arg name="launch_amcl_and_mapserver" value="$(arg amcl_and_mapserver)" />
		<arg name="map_file" value="$(arg map_file)" />
		<arg name="launch_move_base" value="$(arg move_base_robot)" />
		<arg name="omni_drive" value="$(arg omni_drive)" />
		<arg name="ros_planar_move_plugin" value="$(arg ros_planar_move_plugin)" />
		<arg name="use_gpu_for_simulation" value="$(arg use_gpu_for_simulation)" />
		<arg name="gps_latitude" value="$(arg gps_latitude_robot)" />
		<arg name="gps_longitude" value="$(arg gps_longitude_robot)" />
	</include>


	<!-- gazebo simulation and rviz visualization-->
	<include file="$(find summit_xl_gazebo)/launch/gazebo_rviz.launch">
		<arg name="launch_rviz" value="$(arg launch_rviz)" />
		<arg name="world" value="$(arg gazebo_world)" />
		<arg name="debug" value="$(arg debug)" />
		<arg name="gazebo_gui" value="$(arg gazebo_gui)" />
	</include>

</launch>