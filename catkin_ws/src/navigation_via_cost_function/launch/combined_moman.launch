<?xml version="1.0"?>
<launch>
    <arg name="demo" default="false"/>
    <arg name="use_rviz" default="true"/>
    <arg name="debug" default="false"/>
    <arg name="x_init_pose_robot" default="0" />
	<arg name="y_init_pose_robot" default="0" />
	<arg name="z_init_pose_robot" default="0" />


    <include file="$(find moman_moveit_config)/launch/demo.launch" if="$(arg demo)"/>
    <!-- <node pkg="tf" type="static_transform_publisher" name="odom_to_world" args="0 0 0 0 0 0 world odom 100" if="$(arg demo)" /> -->
    <!-- <include file="$(find moman_moveit_config)/launch/demo_gazebo.launch" unless="$(arg demo)"/> -->

    <include file="$(find summit_xl_sim_bringup)/launch/summit_xls_panda.launch" >
        <arg name="x_init_pose_robot" value="$(arg x_init_pose_robot)" />
        <arg name="y_init_pose_robot" value="$(arg y_init_pose_robot)" />
        <arg name="z_init_pose_robot" value="$(arg z_init_pose_robot)" />
    </include>

    <!-- <include file="$(find moman_moveit_config)/launch/moveit_rviz.launch" if="$(arg use_rviz)">
         <arg name="rviz_config" value="$(find moman_moveit_config)/moveit2.rviz"/> 
        
        <arg name="debug" value="$(arg debug)"/>
    </include> -->

    <!-- spawn of obstacles -->
    <!-- <node pkg="gazebo_ros" type="spawn_model" name="spawn_box1" args="-urdf -file $(find navigation_via_cost_function)/include/box.urdf -model box1 -x -2 -y 1" /> -->
    <!-- <node pkg="gazebo_ros" type="spawn_model" name="spawn_box2" args="-urdf -file $(find navigation_via_cost_function)/include/box.urdf -model box2 -x 1 -y 1" /> -->
    <!-- <node pkg="gazebo_ros" type="spawn_model" name="spawn_person" args="-urdf -file $(find navigation_via_cost_function)/include/person.urdf -model person -x 4 -y 0" /> -->

    <node pkg="laser2pc" type="laser2pc.py" name="laser2PC_node" output="screen" />
    
    <node pkg="ground_filter" type="ground_filter" name="ground_filter_node" output="screen" />


    <!-- <node pkg="navigation_via_cost_function" type="person_position.py" name="person_position" output="screen" /> -->

    <node pkg="navigation_via_cost_function" type="person_position_motion.py" name="person_position" output="screen" />

    <!-- <node pkg= "realtime_tracking" type="realtime_tracking" name="realtime_tracking" output="screen" /> -->
    
    <!-- <node pkg="navigation_via_cost_function" type="cost_opt_service" name="cost_opt_service" output="screen" /> -->
    
    <node pkg="navigation_via_cost_function" type="moman_navigation.py" name="moman_node" output="screen">
        <param name="robot_name" value="summit_xl" />
        <param name="demo" value="$(arg demo)" />
        <param name="development" value="true" />

    </node>
</launch>