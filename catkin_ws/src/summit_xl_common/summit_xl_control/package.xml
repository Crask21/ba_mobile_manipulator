<?xml version="1.0"?>
<package>
  <name>summit_xl_control</name>
  <version>1.1.3</version>
  <description>
    This package contains the launch files that load the required controller interfaces for
    simulation in Gazebo.
  </description>

  <author email="rguzman@robotnik.es">Roberto Guzmán</author>

  <maintainer email="asoriano@robotnik.es">Angel Soriano</maintainer>
  <maintainer email="avillena@robotnik.es">Álvaro Villena</maintainer>
  <maintainer email="dredo@robotnik.es">David Redó</maintainer>
  <maintainer email="aarnal@robotnik.es">Alejandro Arnal</maintainer>
  <maintainer email="mbosch@robotnik.es">Marc Bosch</maintainer>
  <maintainer email="rnavarro@robotnik.es">Román Navarro</maintainer>

  <license>BSD</license>
  <url type="website">http://ros.org/wiki/summit_xl_control</url>
  <url type="repository">https://github.com/RobotnikAutomation/summit_xl_sim.git</url>
  <url type="bugtracker">https://github.com/RobotnikAutomation/summit_xl_sim/issues</url>
  <buildtool_depend>catkin</buildtool_depend>

  <!-- from panda -->


  <build_depend>libfranka</build_depend>
  <build_depend>controller_interface</build_depend>
  <build_depend>controller_manager</build_depend>
  <build_depend>franka_hw</build_depend>
  <build_depend>franka_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>realtime_tools</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf2_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>std_srvs</build_depend>


  <build_depend>joint_state_controller</build_depend>
  <build_depend>velocity_controllers</build_depend>
  <build_depend>twist_mux</build_depend>
  <build_depend>diff_drive_controller</build_depend>

  <run_depend>joint_state_controller</run_depend>
  <run_depend>velocity_controllers</run_depend>
  <run_depend>twist_mux</run_depend>
  <run_depend>diff_drive_controller</run_depend>

  <!-- from panda -->
  <!-- previously just <depend> -->
  <run_depend>libfranka</run_depend>
  <run_depend>controller_interface</run_depend>
  <run_depend>controller_manager</run_depend>
  <run_depend>franka_hw</run_depend>
  <run_depend>franka_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>pluginlib</run_depend>
  <run_depend>realtime_tools</run_depend>
  <run_depend>roscpp</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>tf2_msgs</run_depend>
  <run_depend>tf</run_depend>
  <run_depend>std_srvs</run_depend>

  <!-- previously <exec_depend> -->
  <run_depend>franka_description</run_depend>
  <run_depend>franka_gripper</run_depend>
  <run_depend>joint_state_publisher</run_depend>
  <run_depend>joint_trajectory_controller</run_depend>
  <run_depend>robot_state_publisher</run_depend>

</package>