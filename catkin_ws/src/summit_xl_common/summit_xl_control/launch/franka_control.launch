<?xml version="1.0"?>
<launch>


  <!-- interface from call -->
  <arg name="prefix" default="robot_" />
  <arg name="arm_model" default="vx300s" />
  <arg name="arm_prefix" default="$(arg prefix)$(arg arm_model)" />
  <arg name="use_trajectory_controller" default="true" />

  <arg name="robot_ip" default="$(arg prefix)" />
  <arg name="robot" default="panda" doc="choose your robot. Possible values: [panda, fr3]" />
  <arg name="arm_id" default="$(arg prefix)" />
  <arg name="load_gripper" default="false" />
  <arg name="xacro_args" default="" />

  <!-- <param name="robot_description"
    command="$(find xacro)/xacro $(find franka_description)/robots/$(arg robot)/$(arg robot).urdf.xacro
  hand:=$(arg load_gripper) arm_id:=$(arg arm_id) $(arg xacro_args)" /> -->

  <!-- included from panda gazebo-->


  <node name="franka_control" pkg="franka_control" type="franka_control_node" output="screen"
    required="true">
    <rosparam command="load" file="$(find franka_control)/config/franka_control_node.yaml"
      subst_value="true" />
    <param name="robot_ip" value="$(arg robot_ip)" />
  </node>

  <rosparam command="load" file="$(find franka_control)/config/default_controllers.yaml"
    subst_value="true" />
  <!-- <node name="state_controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
    output="screen" args="franka_state_controller" /> -->
</launch>