<!-- this file will launch the two robots seperately -->

<launch>
    <include file="$(find summit_xl_sim_bringup)/launch/summit_xls_panda.launch" />
    <include file="$(find franka_gazebo)/launch/panda.launch" />
    <!-- create a static transform between the two -->
    <node pkg="tf" type="static_transform_publisher" name="panda_to_summit_xl"
        args="0.2 -0.15 0.380 0 0 0 robot_base_link panda_link0 100" />

</launch>